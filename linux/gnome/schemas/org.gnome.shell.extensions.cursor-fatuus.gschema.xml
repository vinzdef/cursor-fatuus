<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.cursor-fatuus" path="/org/gnome/shell/extensions/cursor-fatuus/">
    <key name="enabled" type="b">
      <default>true</default>
    </key>
    <key name="color" type="ad">
      <default>[1.0, 1.0, 1.0]</default>
      <summary>Tint color</summary>
      <description>sRGB components in 0–1. Empty shows no color, leaving blur and invert unobstructed.</description>
    </key>
    <key name="opacity" type="d">
      <range min="0" max="1"/>
      <default>0.1</default>
      <summary>Opacity of the whole halo: color, blur and invert together</summary>
    </key>
    <key name="blur-radius" type="d">
      <range min="0" max="10"/>
      <default>0.0</default>
      <summary>Blur radius; 0 turns blur off</summary>
    </key>
    <key name="invert" type="b">
      <default>false</default>
    </key>
    <key name="radius" type="d">
      <range min="1" max="300"/>
      <default>175.0</default>
    </key>
    <key name="softness" type="d">
      <range min="0" max="1"/>
      <default>1.0</default>
      <summary>0 is a hard-edged circle; 1 fades all the way from the center</summary>
    </key>
  </schema>
</schemalist>
